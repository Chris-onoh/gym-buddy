# 1. Get a FREE PostgreSQL at neon.tech (takes 2 min)
# 2. Copy the connection string, it looks like:
#    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/gymbuddy?sslmode=require
DATABASE_URL="postgresql://..."

# 3. Generate a random secret:
#    openssl rand -base64 32
AUTH_SECRET="generate-me"

# 4. Set to true for production
AUTH_TRUST_HOST=true

# 5. Your Netlify URL
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"
